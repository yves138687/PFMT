# .IDEA
.idea/

# codex
.codex/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# PFMT local configuration and secrets
.env
.env.*
!.env.example
# Production secrets are generated locally and must never be committed.
/.env.production

# Python development artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Frontend development artifacts
web/node_modules/
web/dist/
web/.vite/
web/playwright-report/
web/test-results/
web/coverage/
web/package-lock.json
web/pnpm-lock.yaml

# Local storage, SQLite database, encrypted objects, logs and caches
storage/**
!storage/
!storage/.gitkeep
*.sqlite
*.sqlite3
