# PFMT 本地开发配置示例
# 复制为 .env 后再修改；不要提交 .env 或任何真实密钥。

PFMT_ENV=dev
PFMT_DEBUG=true

# 后端 FastAPI
PFMT_SERVER_HOST=127.0.0.1
PFMT_SERVER_PORT=8000
PFMT_API_BASE_URL=http://127.0.0.1:8000
PFMT_API_PREFIX=/api

# 前端 Vite
# 默认监听所有网卡，便于同一局域网设备访问；只允许本机访问时改回 127.0.0.1。
PFMT_WEB_HOST=0.0.0.0
PFMT_WEB_PORT=5173
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# SQLite 与本地文件存储
# 默认不配置 PFMT_DATABASE_URL 时，SQLite 会写入 PFMT_STORAGE_ROOT/pfmt.sqlite3。
# 如需单独指定数据库位置，再取消下一行注释并改成实际路径。
# PFMT_DATABASE_URL=sqlite:///./storage/pfmt.sqlite3
PFMT_STORAGE_ROOT=./storage

# 单用户初始化示例；本地运行前请替换密码。
PFMT_ADMIN_USERNAME=admin
PFMT_ADMIN_PASSWORD=admin123456
PFMT_ADMIN_DISPLAY_NAME=个人知识库管理员

# 示例密钥占位值；必须在本地 .env 中替换。
PFMT_JWT_SECRET_KEY=replace_with_local_dev_jwt_secret_32_bytes_min
PFMT_FILE_MASTER_KEY=replace_with_local_dev_file_master_key_32_bytes_min
PFMT_JWT_ALGORITHM=HS256
PFMT_JWT_ACCESS_TOKEN_MINUTES=480

# 第一阶段关键开关
PFMT_FILE_ENCRYPTION_ENABLED=true
PFMT_HIDDEN_FEATURE_ENABLED=true
PFMT_SHOW_HIDDEN_BY_DEFAULT=false
# 隐藏内容二次验证码最小长度（默认 6 位）
PFMT_HIDDEN_VERIFY_PASSWORD_MIN_LENGTH=6
PFMT_AI_ENABLED=false
PFMT_BACKUP_ENABLED=false

# 开发期日志
PFMT_LOG_LEVEL=INFO
PFMT_LOG_FILE=./storage/logs/pfmt-dev.log
